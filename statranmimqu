import java.util.*;
public class Statranmimq {
    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n=sc.nextInt();
        int q=sc.nextInt();
        int[] x = new int[n+1];
        for(int i=1;i<=n;i++){
            x[i]=sc.nextInt();
        }
        while(q-->0){
            int lt=sc.nextInt();
            int rt=sc.nextInt();
            int min =Integer.MAX_VALUE;
            for(int j=lt;j<=rt;j++){
                min=Math.min(min,x[j]);
            }
            System.out.println(min);
        }
        sc.close();
    }
}
