import java.util.*;
public class Main{
	public static void main(String[] args){
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		int q=sc.nextInt();
		long []arr=new long[n+1];
		arr[0]=0;
		for(int i=1;i<=n;i++){
			arr[i]=arr[i-1]+sc.nextLong();
		}
		for(int i=0;i<q;i++){
			int a=sc.nextInt();
			int b=sc.nextInt();
			System.out.println(arr[b]-arr[a-1]);
		}
	
	}
